node_modules/
.DS_Store

# Card masters and contact sheets are DERIVED from photos/ithos + photos/focus.json.
# The web renditions under public/ are versioned on purpose (a build step that
# regenerates everything on every publish cost 197s per save on another project),
# but these two are review material, not the site.
photos/_cards/
photos/_contact/

# The photographer's originals and the client's portfolio live ONE folder up, in
# _materiais-ithos-cathelier, and are not copied in here. This project once got
# built INSIDE that folder by accident — macOS does not distinguish
# `Ithos-Cathelier` from `ithos-cathelier`, they were the same directory, and
# the first push carried a 328 MB PDF with it. Keep the two apart.

# The battery is copied into public/ to run and removed again. It is not the site.
public/_battery.js
public/_drive.html
