// O SITE NA CLOUDFLARE: um Worker com os ficheiros estáticos (a pasta public/
// que o gerador escreve), servidos directamente, sem contar para a quota de
// pedidos do Worker. O único código é worker/intervalos.js, e só corre para o
// vídeo da capa (/media/film/*), que precisa de pedidos por intervalos no iOS.
//
// PORQUÊ: os termos do GitHub Pages proíbem usá-lo para uma loja online
// («not intended for or allowed to be used … to run your online business,
// e-commerce site» — GitHub Terms for Additional Products and Features, Pages).
// Ver o plano em README / notas de 26 set 2026.
//
// PUBLICA-SE SÓ PELO CI (.github/workflows/publish.yml). Um `wrangler deploy`
// à mão publicava o public/ local, que não é o do CI: sem PREVIEW (indexável),
// sem API_URL (sem stock, revenda nem retratação) e sem as versões web das
// fotografias do painel. (E nunca a partir da pasta-mãe: a autoconfiguração
// inventa um Worker com o conteúdo de outro projecto.)
{
  "name": "ithos-cathelier-site",
  "compatibility_date": "2026-09-01",
  "main": "worker/intervalos.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Só o vídeo passa pelo script; tudo o resto é ficheiro, como antes.
    "run_worker_first": ["/media/film/*"],
    // Uma morada que não existe mostra a 404.html (o valor por omissão, «none»,
    // devolvia um 404 vazio).
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // O DOMÍNIO CHEGA POR ROUTE, E NÃO POR «CUSTOM DOMAIN». Um Custom Domain
  // obriga a apagar primeiro os registos A que lá estão (apontavam para o
  // GitHub Pages); um resolvedor que pergunte nesse intervalo guarda a falta
  // durante o mínimo do SOA (1800 s, que no plano Free não se muda). Com uma
  // route, os A ficam onde estão e só passam a «Proxied»: a resposta nunca
  // fica vazia, e todo o pedido ao domínio é servido por estes ficheiros (o
  // IP para onde os A apontam deixa de importar -- a origem nunca é
  // contactada). O www não está aqui: vai para o apex por uma Redirect Rule
  // da zona.
  // (Com o GitHub Pages apagado, ficou um só A, proxied, para 192.0.2.1 — um
  // endereço que não leva a lado nenhum: nenhuma origem responde por nós.)
  // (Ensaiado a 26 set 2026 em teste.ithos-cathelier.pt, a apontar para um
  // IP que não leva a lado nenhum: páginas, 404, ficheiros e robots.txt vieram
  // todos do Worker.)
  "routes": [
    { "pattern": "ithos-cathelier.pt/*", "zone_name": "ithos-cathelier.pt" }
  ],
  // O endereço workers.dev serviu de ensaio até o domínio passar para aqui;
  // desligado, para o site não existir também noutra morada.
  "workers_dev": false,
  "preview_urls": false
}
